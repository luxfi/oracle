    "@types/url-join": "^5.0.0",
    "@typescript-eslint/parser": "^8.68.0",
    "axios": "^1.20.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@google-cloud/datastore": "^11.0.1",
    "@types/express": "^5.0.6",
    "@uma/financial-templates-lib": "^2.37.2",
    "@uma/sdk": "^0.34.13",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "isomorphic-fetch": "^3.0.0",
    "lodash": "^4.18.1",
