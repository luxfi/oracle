{
  "version": "0.34.1",
  "license": "MIT",
  "name": "@uma/sdk",
  "author": "David Adams",
  "main": "dist/node/index.js",
  "module": "dist/web/index.js",
  "typings": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "node ./build.js",
    "build:web": "ENV_TYPE=web tsdx build --target web --format esm --name index",
    "build:node": "tsdx build --target node --format cjs --name index",
    "test": "jest",
    "test:e2e": "tsdx test --config jest-e2e-config.json",
    "test:watch": "tsdx test --watch",
    "eslint": "eslint './src/**/*.ts'",
    "prettier": "prettier './**/*.md' './src/**/*.ts'",
    "lint": "yarn prettier --write && yarn eslint --fix",
    "prepare": "yarn build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "size-limit": [
    {
      "path": "dist/web/index.js",
      "limit": "500 KB"
    }
  ],
  "dependencies": {
    "@eth-optimism/core-utils": "^0.13.2",
    "@ethersproject/abstract-signer": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@google-cloud/datastore": "^11.0.1",
    "@types/lodash-es": "^4.17.12",
    "@uma/contracts-frontend": "^0.4.28",
    "@uma/contracts-node": "^0.4.28",
    "axios": "^1.20.0",
    "bluebird": "^3.7.2",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0",
    "highland": "^2.13.5",
    "immer": "^11.1.18",
    "lodash-es": "^4.18.1"
  },
  "peerDependencies": {
    "@eth-optimism/contracts": "^0.5.40",
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/bluebird": "^3.5.42",
    "@types/bn.js": "^5.2.0",
    "@types/dotenv": "^8.2.3",
    "@types/highland": "^2.13.0",
    "@types/jest": "^30.0.0",
    "dotenv": "^17.4.2",
    "jest": "^30.5.0",
    "size-limit": "^13.0.3",
    "ts-jest": "^29.4.12",
    "tsdx": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com/",
    "access": "public"
  }
}
